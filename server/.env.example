# Taskify Server Environment Configuration
# Copy this file to .env inside the server directory

# Server Port
PORT=5000

# Client Origins for CORS (Allowed frontend URLs)
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# MongoDB Connection String (MongoDB Atlas cluster or local mongodb://127.0.0.1:27017/taskify)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/taskify?retryWrites=true&w=majority

# JWT Secret for Session & Authentication Tokens
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# Firebase Admin SDK Configuration (Required for verifying Google Auth ID tokens)
# Obtain these from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Email Configuration (Nodemailer - Optional; if omitted, emails log to console for development)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
